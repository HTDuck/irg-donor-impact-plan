oup.org/#contact","donate","Online Donations","Donate now","https://givebutter.com/IRG-2026",{"_57":88,"_61":89,"_81":90,"_83":91,"_84":92,"_86":93},{"_57":79,"_61":80,"_81":82,"_83":76,"_84":85,"_86":87},"givebutter","Donate","payload","https://qr.generatorqr.com/4MeNpLjVV","destination","imageSrc","/irg-donor-impact-plan/qr/givebutter.svg","alt","QR code for the IRG donation page","website","IRG Main Site","https://qr.generatorqr.com/4Mc2eTHbV","https://integratedresponsegroup.org/","/irg-donor-impact-plan/qr/website.svg","QR code for the Integrated Response Group website","instagram","https://www.instagram.com/irgops","facebook","https://www.facebook.com/integratedresponsegroup/","socialHub","IRS 501(c)(3) Registered Nonprofit","guideEntry",{"_57":167,"_61":26,"_119":168,"_63":169,"_122":167},"primaryNavigation",[108,109,116],"sectionNavigation",[160,161,162,163,164,165],"guideNavigation",[108,109,110,111,112,113,114,115,116],{"_57":155,"_61":156,"_119":157,"_63":158,"_122":159},{"_57":150,"_61":151,"_119":152,"_63":153,"_122":154},{"_57":145,"_61":146,"_119":147,"_63":148,"_122":7,"_127":149},{"_57":140,"_61":141,"_119":142,"_63":143,"_122":7,"_127":144},{"_57":136,"_61":137,"_119":138,"_63":139,"_122":7,"_127":136},{"_57":132,"_61":133,"_119":134,"_63":135,"_122":7,"_127":132},{"_57":128,"_61":129,"_119":130,"_63":131,"_122":7,"_127":128},{"_57":123,"_61":124,"_119":125,"_63":126,"_122":7,"_127":123},{"_57":117,"_61":118,"_119":120,"_63":121,"_122":117},"give","How to Give","path","/give/","/irg-donor-impact-plan/give/","kind","public-relations","Public Relations","/sections/public-relations/","/irg-donor-impact-plan/sections/public-relations/","accent","aviation","Aviation","/sections/aviation/","/irg-donor-impact-plan/sections/aviation/","logistics","Logistics","/sections/logistics/","/irg-donor-impact-plan/sections/logistics/","medical","Medical","/sections/medical/","/irg-donor-impact-plan/sections/medical/","crisis-intelligence-management","Crisis Intelligence Management","/sections/crisis-intelligence-management/","/irg-donor-impact-plan/sections/crisis-intelligence-management/","crisis","command-and-control","Command & Control","/sections/command-and-control/","/irg-donor-impact-plan/sections/command-and-control/","command","sections","Operational Sections","/sections/","/irg-donor-impact-plan/sections/","index","executive-summary","Executive Summary","/executive-summary/","/irg-donor-impact-plan/executive-summary/","summary",{"_57":145,"_61":146,"_119":147,"_63":148,"_122":7,"_127":149},{"_57":140,"_61":166,"_119":142,"_63":143,"_122":7,"_127":144},{"_57":136,"_61":137,"_119":138,"_63":139,"_122":7,"_127":136},{"_57":132,"_61":133,"_119":134,"_63":135,"_122":7,"_127":132},{"_57":128,"_61":129,"_119":130,"_63":131,"_122":7,"_127":128},{"_57":123,"_61":124,"_119":125,"_63":126,"_122":7,"_127":123},"Crisis Intelligence","home","/","/irg-donor-impact-plan/","canonicalUrl","https://htduck.github.io/irg-donor-impact-plan/sections/aviation/","Aviation Section","navLabel","Coordinated aerial operations, UAS missions, and manned aircraft support.","order",5,"ogImageUrl","https://htduck.github.io/irg-donor-impact-plan/media/aviation-helicopter-equipment-transfer/aviation-helicopter-equipment-transfer-1244.jpg","publish",true,"shortTitle","tagline","Reaching what ground teams cannot.","bodyHtml","<h2>What we do</h2>\n<p>IRG&#39;s Aviation Section provides coordinated aerial operations that transform a reactive disaster response into a decisive, precision-driven operation. Our licensed pilots and UAS operators deploy aircraft to conduct search and rescue support, emergency supply deliveries, and overhead damage assessments in areas where roads are impassable, bridges are out, or floodwaters make ground access impossible.</p>\n<h2>How we do it</h2>\n<ul>\n<li>Ensure all coordinated pilots and drone operators are properly qualified and certificated for the assigned mission.</li>\n<li>Operate only in authorized airspace, in compliance with Temporary Flight Restrictions.</li>\n<li>Aerial operations under Part 91 and through vetted partners (NGOs, Part 135, Local, State, and Federal Law Enforcement, and National Guard.</li>\n<li>Drone (UAS) operations under Part 107—mapping, thermal imaging, live data feeds.</li>\n<li>Manned aircraft conducting search support, targeted supply deliveries, and overhead damage assessment.</li>\n<li>Serve as lead among Air Care Alliance aviation NGOs, while building enduring partnerships with new aviation NGOs.</li>\n</ul>\n<h2>What your donation funds</h2>\n<p>Donations enable IRG&#39;s Aviation Section to maintain mission-ready aerial response capabilities, including equipment readiness and coordination systems that allow aviation assets to be effectively leveraged in a rapid response situation to support vetted partners and government agencies.</p>",[320,321,322],"content",{"_314":315,"_316":317,"_318":319},"gallery",[191,192,193],{"_57":278,"_195":279,"_197":128,"_86":280,"_199":281,"_201":282,"_203":283,"_205":284},{"_57":243,"_195":244,"_197":128,"_86":245,"_199":246,"_201":247,"_203":248,"_205":249},{"_57":194,"_195":196,"_197":128,"_86":198,"_199":200,"_201":202,"_203":204,"_205":206},"photo-14","slug","aviation-coastal-damage-assessment","sectionId","Aerial view of extensive damage across a coastal community beside the shoreline.","width",1208,"height",958,"sources",{"_207":208,"_209":210,"_211":212},"fallbackSrc","/irg-donor-impact-plan/media/aviation-coastal-damage-assessment/aviation-coastal-damage-assessment-1208.jpg","avif",[235,236,237,238],"webp",[227,228,229,230],"jpeg",[213,214,215,216],{"_217":224,"_199":225,"_201":226},{"_217":221,"_199":222,"_201":223},{"_217":218,"_199":219,"_201":220},{"_217":206,"_199":200,"_201":202},"src","/irg-donor-impact-plan/media/aviation-coastal-damage-assessment/aviation-coastal-damage-assessment-1200.jpg",1200,952,"/irg-donor-impact-plan/media/aviation-coastal-damage-assessment/aviation-coastal-damage-assessment