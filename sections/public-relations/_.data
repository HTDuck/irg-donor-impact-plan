Intelligence Management","/sections/crisis-intelligence-management/","/irg-donor-impact-plan/sections/crisis-intelligence-management/","crisis","command-and-control","Command & Control","/sections/command-and-control/","/irg-donor-impact-plan/sections/command-and-control/","command","sections","Operational Sections","/sections/","/irg-donor-impact-plan/sections/","index","executive-summary","Executive Summary","/executive-summary/","/irg-donor-impact-plan/executive-summary/","summary",{"_57":145,"_61":146,"_119":147,"_63":148,"_122":7,"_127":149},{"_57":140,"_61":166,"_119":142,"_63":143,"_122":7,"_127":144},{"_57":136,"_61":137,"_119":138,"_63":139,"_122":7,"_127":136},{"_57":132,"_61":133,"_119":134,"_63":135,"_122":7,"_127":132},{"_57":128,"_61":129,"_119":130,"_63":131,"_122":7,"_127":128},{"_57":123,"_61":124,"_119":125,"_63":126,"_122":7,"_127":123},"Crisis Intelligence","home","/","/irg-donor-impact-plan/","canonicalUrl","https://htduck.github.io/irg-donor-impact-plan/sections/public-relations/","Public Relations Section","navLabel","Public affairs, donor relations, media strategy, and community outreach.","order",6,"ogImageUrl","https://htduck.github.io/irg-donor-impact-plan/media/public-relations-outdoor-team/public-relations-outdoor-team-1204.jpg","publish",true,"shortTitle","tagline","Transparency through communication, across all teams.","bodyHtml","<h2>What we do</h2>\n<p>IRG&#39;s Public Relations Section is the public face of the organization. By managing public affairs, donor relations, media coordination, and community outreach, this team builds the trust, credibility, and brand identity that allows IRG to complete the mission.</p>\n<h2>How we do it</h2>\n<ul>\n<li>Pre-deployment public briefings and community outreach messaging.</li>\n<li>Real-time social media updates and field documentation during active missions.</li>\n<li>Coordinate Traditional and Non-traditional media relations.</li>\n<li>Post-deployment donor impact reports and partner agency debriefs.</li>\n<li>Grant research, proposal writing, and compliance reporting for institutional funders.</li>\n<li>Brand management: consistent visual identity across all IRG platforms and materials.</li>\n<li>Volunteer recruitment campaigns and section-specific outreach.</li>\n</ul>\n<h2>What your donation funds</h2>\n<p>IRG&#39;s Public Relations Section is the public face of the organization. By managing public affairs, donor relations, media coordination, and community outreach, this team builds the trust, credibility, and brand identity that allows IRG to complete the mission.</p>",[306,307,308],"content",{"_301":302,"_303":304,"_305":302},"gallery",[191,192,193],{"_57":264,"_195":265,"_197":123,"_86":266,"_199":267,"_201":268,"_203":269,"_205":270},{"_57":235,"_195":236,"_197":123,"_86":237,"_199":238,"_201":239,"_203":240,"_205":241},{"_57":194,"_195":196,"_197":123,"_86":198,"_199":200,"_201":202,"_203":204,"_205":206},"photo-11","slug","public-relations-indoor-team","sectionId","Four adults stand together inside a busy facility.","width",1181,"height",884,"sources",{"_207":208,"_209":210,"_211":212},"fallbackSrc","/irg-donor-impact-plan/media/public-relations-indoor-team/public-relations-indoor-team-1181.jpg","avif",[229,230,231],"webp",[223,224,225],"jpeg",[213,214,215],{"_216":220,"_199":221,"_201":222},{"_216":217,"_199":218,"_201":219},{"_216":206,"_199":200,"_201":202},"src","/irg-donor-impact-plan/media/public-relations-indoor-team/public-relations-indoor-team-800.jpg",800,599,"/irg-donor-impact-plan/media/public-relations-indoor-team/public-relations-indoor-team-480.jpg",480,359,{"_216":228,"_199":221,"_201":222},{"_216":227,"_199":218,"_201":219},{"_216":226,"_199":200,"_201":202},"/irg-donor-impact-plan/media/public-relations-indoor-team/public-relations-indoor-team-1181.webp","/irg-donor-impact-plan/media/public-relations-indoor-team/public-relations-indoor-team-800.webp","/irg-donor-impact-plan/media/public-relations-indoor-team/public-relatio