dresponsegroup.org/#contact","donate","Online Donations","Donate now","https://givebutter.com/IRG-2026",{"_57":88,"_61":89,"_81":90,"_83":91,"_84":92,"_86":93},{"_57":79,"_61":80,"_81":82,"_83":76,"_84":85,"_86":87},"givebutter","Donate","payload","https://qr.generatorqr.com/4MeNpLjVV","destination","imageSrc","/irg-donor-impact-plan/qr/givebutter.svg","alt","QR code for the IRG donation page","website","IRG Main Site","https://qr.generatorqr.com/4Mc2eTHbV","https://integratedresponsegroup.org/","/irg-donor-impact-plan/qr/website.svg","QR code for the Integrated Response Group website","instagram","https://www.instagram.com/irgops","facebook","https://www.facebook.com/integratedresponsegroup/","socialHub","IRS 501(c)(3) Registered Nonprofit","guideEntry",{"_57":167,"_61":26,"_119":168,"_63":169,"_122":167},"primaryNavigation",[108,109,116],"sectionNavigation",[160,161,162,163,164,165],"guideNavigation",[108,109,110,111,112,113,114,115,116],{"_57":155,"_61":156,"_119":157,"_63":158,"_122":159},{"_57":150,"_61":151,"_119":152,"_63":153,"_122":154},{"_57":145,"_61":146,"_119":147,"_63":148,"_122":7,"_127":149},{"_57":140,"_61":141,"_119":142,"_63":143,"_122":7,"_127":144},{"_57":136,"_61":137,"_119":138,"_63":139,"_122":7,"_127":136},{"_57":132,"_61":133,"_119":134,"_63":135,"_122":7,"_127":132},{"_57":128,"_61":129,"_119":130,"_63":131,"_122":7,"_127":128},{"_57":123,"_61":124,"_119":125,"_63":126,"_122":7,"_127":123},{"_57":117,"_61":118,"_119":120,"_63":121,"_122":117},"give","How to Give","path","/give/","/irg-donor-impact-plan/give/","kind","public-relations","Public Relations","/sections/public-relations/","/irg-donor-impact-plan/sections/public-relations/","accent","aviation","Aviation","/sections/aviation/","/irg-donor-impact-plan/sections/aviation/","logistics","Logistics","/sections/logistics/","/irg-donor-impact-plan/sections/logistics/","medical","Medical","/sections/medical/","/irg-donor-impact-plan/sections/medical/","crisis-intelligence-management","Crisis Intelligence Management","/sections/crisis-intelligence-management/","/irg-donor-impact-plan/sections/crisis-intelligence-management/","crisis","command-and-control","Command & Control","/sections/command-and-control/","/irg-donor-impact-plan/sections/command-and-control/","command","sections","Operational Sections","/sections/","/irg-donor-impact-plan/sections/","index","executive-summary","Executive Summary","/executive-summary/","/irg-donor-impact-plan/executive-summary/","summary",{"_57":145,"_61":146,"_119":147,"_63":148,"_122":7,"_127":149},{"_57":140,"_61":166,"_119":142,"_63":143,"_122":7,"_127":144},{"_57":136,"_61":137,"_119":138,"_63":139,"_122":7,"_127":136},{"_57":132,"_61":133,"_119":134,"_63":135,"_122":7,"_127":132},{"_57":128,"_61":129,"_119":130,"_63":131,"_122":7,"_127":128},{"_57":123,"_61":124,"_119":125,"_63":126,"_122":7,"_127":123},"Crisis Intelligence","home","/","/irg-donor-impact-plan/","canonicalUrl","https://htduck.github.io/irg-donor-impact-plan/sections/command-and-control/","Command & Control Section","navLabel","Satellite comms, digital command infrastructure, and real-time situational awareness.","order",1,"ogImageUrl","https://htduck.github.io/irg-donor-impact-plan/media/command-control-operational-briefing/command-control-operational-briefing-1280.jpg","publish",true,"shortTitle","tagline","The nervous system of every IRG deployment.","bodyHtml","<h2>What we do</h2>\n<p>IRG&#39;s Command and Control Section is the operational backbone of every mission. This team maintains uninterrupted communication, mobile command infrastructure, and the real-time situational awareness that keeps every section aligned. In disaster zones, communications infrastructure is often the first casualty—Command and Control Section bridges the gap until restoration.</p>\n<h2>How we do it</h2>\n<ul>\n<li>Satellite internet deployment (Starlink, etc.) at field command posts and staging areas.</li>\n<li>Digital App Chat for instant communications via text, voice, or video across multiple platforms.</li>\n<li>Radio network setup across multiple bands.</li>\n<li>Proprietary integrated digital command dashboard to provide a common operating picture across responding organizations.</li>\n<li>Cybersecurity and COMSEC protocols to protect sensitive operational data.</li>\n<li>Field computing: ruggedized laptops, tablets, encrypted drives, and mobile hotspots.</li>\n<li>Power systems: generators, solar charging kits, and battery banks for off-grid stability.</li>\n<li>Integration with ATAK, Maptician, and partner agency communication platforms.</li>\n</ul>\n<h2>What your donation funds</h2>\n<p>Your donation funds satellite systems, radios, power equipment, and field computing tools that enable rapid deployment of our team. Without this core infrastructure, there is no organized response.</p>",[314,315,316],"content",{"_308":309,"_310":311,"_312":313},"gallery",[191,192,193],{"_57":272,"_195":273,"_197":145,"_86":274,"_199":275,"_201":276,"_203":277,"_205":278},{"_57":235,"_195":236,"_197":145,"_86":237,"_199":238,"_201":239,"_203":240,"_205":241},{"_57":194,"_195":196,"_197":145,"_86":198,"_199":200,"_201":202,"_203":204,"_205":206},"photo-21","slug","command-control-canopy-gathering","sectionId","People gather around tables under a canopy.","width",1169,"height",893,"sources",{"_207":208,"_209":210,"_211":212},"fallbackSrc","/irg-donor-impact-plan/media/command-control-canopy-gathering/command-control-canopy-gathering-1169.jpg","avif",[229,230,231],"webp",[223,224,225],"jpeg",[213,214,215],{"_216":220,"_199":221,"_201":222},{"_216":217,"_199":218,"_201":219},{"_216":206,"_199":200,"_201":202},"src","/irg-donor-impact-plan/media/command-control-canopy-gathering/command-control-canopy-gathering-800.jpg",800,611,"/irg-donor-impact-plan/media/command-control-canopy-gathering/command-control-canopy-gathering-480.jpg",480,367,{"_216":228,"_199":221,"_201":222},{"_216":227,"_199":218,"_201":219},{"_216":226,"_199":200,"_201":202