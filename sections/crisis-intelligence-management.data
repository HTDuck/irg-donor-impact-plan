//integratedresponsegroup.org/#contact","donate","Online Donations","Donate now","https://givebutter.com/IRG-2026",{"_57":88,"_61":89,"_81":90,"_83":91,"_84":92,"_86":93},{"_57":79,"_61":80,"_81":82,"_83":76,"_84":85,"_86":87},"givebutter","Donate","payload","https://qr.generatorqr.com/4MeNpLjVV","destination","imageSrc","/irg-donor-impact-plan/qr/givebutter.svg","alt","QR code for the IRG donation page","website","IRG Main Site","https://qr.generatorqr.com/4Mc2eTHbV","https://integratedresponsegroup.org/","/irg-donor-impact-plan/qr/website.svg","QR code for the Integrated Response Group website","instagram","https://www.instagram.com/irgops","facebook","https://www.facebook.com/integratedresponsegroup/","socialHub","IRS 501(c)(3) Registered Nonprofit","guideEntry",{"_57":167,"_61":26,"_119":168,"_63":169,"_122":167},"primaryNavigation",[108,109,116],"sectionNavigation",[160,161,162,163,164,165],"guideNavigation",[108,109,110,111,112,113,114,115,116],{"_57":155,"_61":156,"_119":157,"_63":158,"_122":159},{"_57":150,"_61":151,"_119":152,"_63":153,"_122":154},{"_57":145,"_61":146,"_119":147,"_63":148,"_122":7,"_127":149},{"_57":140,"_61":141,"_119":142,"_63":143,"_122":7,"_127":144},{"_57":136,"_61":137,"_119":138,"_63":139,"_122":7,"_127":136},{"_57":132,"_61":133,"_119":134,"_63":135,"_122":7,"_127":132},{"_57":128,"_61":129,"_119":130,"_63":131,"_122":7,"_127":128},{"_57":123,"_61":124,"_119":125,"_63":126,"_122":7,"_127":123},{"_57":117,"_61":118,"_119":120,"_63":121,"_122":117},"give","How to Give","path","/give/","/irg-donor-impact-plan/give/","kind","public-relations","Public Relations","/sections/public-relations/","/irg-donor-impact-plan/sections/public-relations/","accent","aviation","Aviation","/sections/aviation/","/irg-donor-impact-plan/sections/aviation/","logistics","Logistics","/sections/logistics/","/irg-donor-impact-plan/sections/logistics/","medical","Medical","/sections/medical/","/irg-donor-impact-plan/sections/medical/","crisis-intelligence-management","Crisis Intelligence Management","/sections/crisis-intelligence-management/","/irg-donor-impact-plan/sections/crisis-intelligence-management/","crisis","command-and-control","Command & Control","/sections/command-and-control/","/irg-donor-impact-plan/sections/command-and-control/","command","sections","Operational Sections","/sections/","/irg-donor-impact-plan/sections/","index","executive-summary","Executive Summary","/executive-summary/","/irg-donor-impact-plan/executive-summary/","summary",{"_57":145,"_61":146,"_119":147,"_63":148,"_122":7,"_127":149},{"_57":140,"_61":166,"_119":142,"_63":143,"_122":7,"_127":144},{"_57":136,"_61":137,"_119":138,"_63":139,"_122":7,"_127":136},{"_57":132,"_61":133,"_119":134,"_63":135,"_122":7,"_127":132},{"_57":128,"_61":129,"_119":130,"_63":131,"_122":7,"_127":128},{"_57":123,"_61":124,"_119":125,"_63":126,"_122":7,"_127":123},"Crisis Intelligence","home","/","/irg-donor-impact-plan/","canonicalUrl","https://htduck.github.io/irg-donor-impact-plan/sections/crisis-intelligence-management/","Crisis Intelligence Management Section","navLabel","Rapid needs assessments, GIS mapping, and situation reporting.","order",2,"ogImageUrl","https://htduck.github.io/irg-donor-impact-plan/media/crisis-intelligence-damaged-homes/crisis-intelligence-damaged-homes-1184.jpg","publish",true,"shortTitle","tagline","Turning chaos into actionable data.","bodyHtml","<h2>What we do</h2>\n<p>IRG&#39;s Crisis Intelligence Management Section conducts rapid needs assessments, tracks resource gaps, monitors population displacement, and produces the situation reports (SitReps) that guide every decision IRG leadership and partner agencies make during a response. Our team collects, refines, and manages the incoming data that prevents waste and directs action with precision.</p>\n<h2>How we do it</h2>\n<ul>\n<li>Rapid needs assessment using OCHA, SPHERE, and FEMA referenced frameworks.</li>\n<li>Use of GIS for damage mapping, population displacement, and identifying aid distribution gaps.</li>\n<li>Pre-event, current, and post-event Situation Reporting writing and dissemination to all partner entities.</li>\n<li>Community-level data collection via structured surveys and key leader engagements.</li>\n<li>Partner integration costs and liaison infrastructure with FEMA and NGO partners.</li>\n<li>Post-event after-action data analysis for lessons learned and future planning.</li>\n<li>Liaison with local government, other NGOs, and federal partners to validate data.</li>\n</ul>\n<h2>What your donation funds</h2>\n<p>Your donation funds the GIS-enabled tools, creation and management of assessment software, field equipment, and training that allow our teams to assess community needs and turn it into actionable response. Without this, resources are misallocated and overall response suffers.</p>",[277,278,279],"content",{"_271":272,"_273":274,"_275":276},"gallery",[191,192],{"_57":242,"_194":243,"_196":140,"_86":244,"_198":245,"_200":246,"_202":247,"_204":248},{"_57":193,"_194":195,"_196":140,"_86":197,"_198":199,"_200":201,"_202":203,"_204":205},"photo-25","slug","crisis-intelligence-road-collapse","sectionId","A collapsed two-lane road runs beside a river and a nearby house.","width",1270,"height",829,"sources",{"_206":207,"_208":209,"_210":211},"fallbackSrc","/irg-donor-impact-plan/media/crisis-intelligence-road-collapse/crisis-intelligence-road-collapse-1270.jpg","avif",[234,235,236,237],"webp",[226,227,228,229],"jpeg",[212,213,214,215],{"_216":223,"_198":224,"_200":225},{"_216":220,"_198":221,"_200":222},{"_216":217,"_198":218,"_200":219},{"_216":205,"_198":199,"_200":201},"src","/irg-donor-impact-plan/media/crisis-intelligence-road-collapse/crisis-intelligence-road-collapse-1200.jpg",1200,783,"/irg-donor-impact-plan/media/crisis-intelligence-road-collapse/crisis-intelligence-road-collapse-800.jpg",800,522,"/irg-donor-impact-plan/media/crisis-intelligence-road-collapse/crisis-intelligence-road-collapse-480.jpg",480,313,{"_21