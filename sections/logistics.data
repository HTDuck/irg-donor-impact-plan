-plan/media/logistics-small-aircraft-supplies/logistics-small-aircraft-supplies-480.jpg",{"_217":269,"_199":225,"_201":226},{"_217":268,"_199":222,"_201":260},{"_217":267,"_199":219,"_201":258},{"_217":266,"_199":246,"_201":247},"/irg-donor-impact-plan/media/logistics-small-aircraft-supplies/logistics-small-aircraft-supplies-1238.webp","/irg-donor-impact-plan/media/logistics-small-aircraft-supplies/logistics-small-aircraft-supplies-1200.webp","/irg-donor-impact-plan/media/logistics-small-aircraft-supplies/logistics-small-aircraft-supplies-800.webp","/irg-donor-impact-plan/media/logistics-small-aircraft-supplies/logistics-small-aircraft-supplies-480.webp",{"_217":277,"_199":225,"_201":226},{"_217":276,"_199":222,"_201":260},{"_217":275,"_199":219,"_201":258},{"_217":274,"_199":246,"_201":247},"/irg-donor-impact-plan/media/logistics-small-aircraft-supplies/logistics-small-aircraft-supplies-1238.avif","/irg-donor-impact-plan/media/logistics-small-aircraft-supplies/logistics-small-aircraft-supplies-1200.avif","/irg-donor-impact-plan/media/logistics-small-aircraft-supplies/logistics-small-aircraft-supplies-800.avif","/irg-donor-impact-plan/media/logistics-small-aircraft-supplies/logistics-small-aircraft-supplies-480.avif","photo-19","logistics-aircraft-supply-transfer","A group moves boxes and packaged supplies beside a truck and passenger aircraft.",1244,954,{"_207":285,"_209":286,"_211":287},"/irg-donor-impact-plan/media/logistics-aircraft-supply-transfer/logistics-aircraft-supply-transfer-1244.jpg",[306,307,308,309],[298,299,300,301],[288,289,290,291],{"_217":296,"_199":225,"_201":297},{"_217":294,"_199":222,"_201":295},{"_217":292,"_199":219,"_201":293},{"_217":284,"_199":281,"_201":282},"/irg-donor-impact-plan/media/logistics-aircraft-supply-transfer/logistics-aircraft-supply-transfer-1200.jpg",920,"/irg-donor-impact-plan/media/logistics-aircraft-supply-transfer/logistics-aircraft-supply-transfer-800.jpg",614,"/irg-donor-impact-plan/media/logistics-aircraft-supply-t