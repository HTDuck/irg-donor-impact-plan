[{"_1":2,"_3":4},"root",{"_5":10},"routes/section-logistics",{"_5":6},"data",{"_7":8,"_9":10,"_11":12,"_13":14},"section",{"_57":132,"_122":7,"_119":134,"_63":135,"_170":171,"_59":172,"_173":133,"_29":174,"_175":176,"_177":178,"_179":180,"_181":133,"_182":183,"_127":132,"_184":185,"_150":186,"_187":188,"_189":190},"shell",{"_11":12,"_13":14,"_100":101,"_102":103,"_104":105,"_106":107},"site",{"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32,"_33":34,"_35":36,"_37":38,"_39":40,"_41":42,"_43":44,"_45":46,"_47":48,"_49":50,"_51":52},"brand",{"_15":16,"_17":18,"_19":20},"markSrc","/irg-donor-impact-plan/brand/irg-mark.svg","horizontalLogoSrc","/irg-donor-impact-plan/brand/irg-logo-horizontal.svg","defaultOpenGraphImageSrc","/irg-donor-impact-plan/media/default-og.jpg","organization","Integrated Response Group","abbreviation","IRG","publicationTitle","Donor Impact Plan","editionLabel","Operational Funding Guide","description","This Donor Impact Plan provides a transparent, section-by-section breakdown of exactly where your contribution goes.","canonicalOrigin","https://htduck.github.io","basePath","/irg-donor-impact-plan","canonicalBaseUrl","https://htduck.github.io/irg-donor-impact-plan/","publishedDate","2026-08-28","missionLine","Precision in Chaos, Unity in Response","foundedLine","Founded and led by veterans.","communityLine","Built for the communities that need us most.","nonprofit",{"_61":99},"links",{"_88":91,"_73":76,"_69":72,"_65":68,"_94":95,"_96":97,"_98":64},"qrCodes",[77,78],"givingActions",[53,54,55,56],{"_57":73,"_59":74,"_61":75,"_63":76},{"_57":69,"_59":70,"_61":71,"_63":72},{"_57":65,"_59":66,"_61":67,"_63":68},{"_57":58,"_59":60,"_61":62,"_63":64},"id","social","title","Instagram and Facebook","label","IRGOPS","href","https://linktr.ee/irgops","volunteer","Volunteer","integratedresponsegroup.org/#help","https://integratedresponsegroup.org/#help","contact","Contact & Partnerships","integratedresponsegroup.org/#contact","https://integratedresponsegroup.org/#contact","donate","Online Donations","Donate now","https://givebutter.com/IRG-2026",{"_57":88,"_61":89,"_81":90,"_83":91,"_84":92,"_86":93},{"_57":79,"_61":80,"_81":82,"_83":76,"_84":85,"_86":87},"givebutter","Donate","payload","https://qr.generatorqr.com/4MeNpLjVV","destination","imageSrc","/irg-donor-impact-plan/qr/givebutter.svg","alt","QR code for the IRG donation page","website","IRG Main Site","https://qr.generatorqr.com/4Mc2eTHbV","https://integratedresponsegroup.org/","/irg-donor-impact-plan/qr/website.svg","QR code for the Integrated Response Group website","instagram","https://www.instagram.com/irgops","facebook","https://www.facebook.com/integratedresponsegroup/","socialHub","IRS 501(c)(3) Registered Nonprofit","guideEntry",{"_57":167,"_61":26,"_119":168,"_63":169,"_122":167},"primaryNavigation",[108,109,116],"sectionNavigation",[160,161,162,163,164,165],"guideNavigation",[108,109,110,111,112,113,114,115,116],{"_57":155,"_61":156,"_119":157,"_63":158,"_122":159},{"_57":150,"_61":151,"_119":152,"_63":153,"_122":154},{"_57":145,"_61":146,"_119":147,"_63":148,"_122":7,"_127":149},{"_57":140,"_61":141,"_119":142,"_63":143,"_122":7,"_127":144},{"_57":136,"_61":137,"_119":138,"_63":139,"_122":7,"_127":136},{"_57":132,"_61":133,"_119":134,"_63":135,"_122":7,"_127":132},{"_57":128,"_61":129,"_119":130,"_63":131,"_122":7,"_127":128},{"_57":123,"_61":124,"_119":125,"_63":126,"_122":7,"_127":123},{"_57":117,"_61":118,"_119":120,"_63":121,"_122":117},"give","How to Give","path","/give/","/irg-donor-impact-plan/give/","kind","public-relations","Public Relations","/sections/public-relations/","/irg-donor-impact-plan/sections/public-relations/","accent","aviation","Aviation","/sections/aviation/","/irg-donor-impact-plan/sections/aviation/","logistics","Logistics","/sections/logistics/","/irg-donor-impact-plan/sections/logistics/","medical","Medical","/sections/medical/","/irg-donor-impact-plan/sections/medical/","crisis-intelligence-management","Crisis Intelligence Management","/sections/crisis-intelligence-management/","/irg-donor-impact-plan/sections/crisis-intelligence-management/","crisis","command-and-control","Command & Control","/sections/command-and-control/","/irg-donor-impact-plan/sections/command-and-control/","command","sections","Operational Sections","/sections/","/irg-donor-impact-plan/sections/","index","executive-summary","Executive Summary","/executive-summary/","/irg-donor-impact-plan/executive-summary/","summary",{"_57":145,"_61":146,"_119":147,"_63":148,"_122":7,"_127":149},{"_57":140,"_61":166,"_119":142,"_63":143,"_122":7,"_127":144},{"_57":136,"_61":137,"_119":138,"_63":139,"_122":7,"_127":136},{"_57":132,"_61":133,"_119":134,"_63":135,"_122":7,"_127":132},{"_57":128,"_61":129,"_119":130,"_63":131,"_122":7,"_127":128},{"_57":123,"_61":124,"_119":125,"_63":126,"_122":7,"_127":123},"Crisis Intelligence","home","/","/irg-donor-impact-plan/","canonicalUrl","https://htduck.github.io/irg-donor-impact-plan/sections/logistics/","Logistics Section","navLabel","Supply chain management, transport coordination, and coalition integration.","order",4,"ogImageUrl","https://htduck.github.io/irg-donor-impact-plan/media/logistics-aircraft-supply-transfer/logistics-aircraft-supply-transfer-1244.jpg","publish",true,"shortTitle","tagline","Good intentions fail without logistics—we ensure their success.","bodyHtml","<h2>What we do</h2>\n<p>IRG&#39;s Logistics Section manages the full supply chain of disaster response—from initial resource procurement and staging to final-mile delivery in affected communities. We coordinate transportation, fuel, equipment allocation, and supply routing so that aid reaches the right place at the right time, without duplication, waste, or dangerous delays.</p>\n<h2>How we do it</h2>\n<ul>\n<li>Pre-event resource procurement and emergency supply stockpiling.</li>\n<li>Staging area setup: receiving, sorting, inventory tracking, and secure storage.</li>\n<li>Ground transportation coordination for supply movement to forward positions.</li>\n<li>Fuel logistics: forward fuel caching and vehicle fueling management.</li>\n<li>Last-mile delivery planning for communities with damaged or flooded road access.</li>\n<li>Coalition integration: shared assets, joint procurement, and pooled transport.</li>\n<li>Resource gap analysis and logistics prioritization briefs for field commanders.</li>\n<li>To prevent the “Second Disaster” we conduct post-deployment inventory reconciliation and lessons learned documentation.</li>\n</ul>\n<h2>What your donation funds</h2>\n<p>Donations fund fuel and transportation to move supplies, emergency stockpiles (water, food, shelter materials), personnel safety gear, and the tracking tools that provide real-time supply visibility. Logistical unity extends IRG&#39;s reach through a broader network of shared assets.</p>",[320,321,322],"content",{"_314":315,"_316":317,"_318":319},"gallery",[191,192,193],{"_57":278,"_195":279,"_197":132,"_86":280,"_199":281,"_201":282,"_203":283,"_205":284},{"_57":243,"_195":244,"_197":132,"_86":245,"_199":246,"_201":247,"_203":248,"_205":249},{"_57":194,"_195":196,"_197":132,"_86":198,"_199":200,"_201":202,"_203":204,"_205":206},"photo-17","slug","logistics-utility-aircraft-loading","sectionId","People and a forklift work beside the open cargo door of a small utility aircraft.","width",1232,"height",918,"sources",{"_207":208,"_209":210,"_211":212},"fallbackSrc","/irg-donor-impact-plan/media/logistics-utility-aircraft-loading/logistics-utility-aircraft-loading-1232.jpg","avif",[235,236,237,238],"webp",[227,228,229,230],"jpeg",[213,214,215,216],{"_217":224,"_199":225,"_201":226},{"_217":221,"_199":222,"_201":223},{"_217":218,"_199":219,"_201":220},{"_217":206,"_199":200,"_201":202},"src","/irg-donor-impact-plan/media/logistics-utility-aircraft-loading/logistics-utility-aircraft-loading-1200.jpg",1200,894,"/irg-donor-impact-plan/media/logistics-utility-aircraft-loading/logistics-utility-aircraft-loading-80